{
    "$schema": "https://www.schemastore.org/package.json",
    "private": true,
    "type": "module",
    "scripts": {
        "build": "vp build",
        "build:ssr": "vp build && vp build --ssr",
        "dev": "vp dev",
        "check": "npm run lint && npm run format:check && npm run types:check",
        "check:fix": "npm run lint:fix && npm run format",
        "lint": "eslint resources/js",
        "lint:fix": "eslint resources/js --fix",
        "format": "prettier --write resources/js",
        "format:check": "prettier --check resources/js",
        "types:check": "vue-tsc --noEmit"
    },
    "dependencies": {
        "@inertiajs/vite": "^3.0.0",
        "@inertiajs/vue3": "^3.0.0",
        "@tailwindcss/vite": "^4.1.11",
        "@vitejs/plugin-vue": "^6.0.0",
        "clsx": "^2.1.1",
        "concurrently": "^10.0.3",
        "laravel-vite-plugin": "^3.1",
        "tailwind-merge": "^3.2.0",
        "tailwindcss": "^4.1.1",
        "typescript": "^5.2.2",
        "vite": "npm:@voidzero-dev/vite-plus-core@1.4.0",
        "vue": "^3.5.13"
    },
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "@laravel/vite-plugin-wayfinder": "^0.1.3",
        "@types/node": "^22.13.5",
        "eslint": "^10.13.0",
        "eslint-config-prettier": "^10.1.8",
        "eslint-plugin-vue": "^10.11.1",
        "globals": "^17.13.0",
        "prettier": "^3.9.10",
        "typescript-eslint": "^8.72.0",
        "vite-plus": "1.4.0",
        "vue-tsc": "^3.3.13"
    },
    "optionalDependencies": {
        "@laravel/multiplex": "^0.4.1",
        "@rollup/rollup-linux-x64-gnu": "4.9.5",
        "@tailwindcss/oxide-linux-x64-gnu": "^4.0.1",
        "lightningcss-linux-x64-gnu": "^1.29.1"
    },
    "overrides": {
        "vite": "npm:@voidzero-dev/vite-plus-core@1.4.0"
    }
}
