#!/usr/bin/env bash
set -euo pipefail
cd "$(dirname "$0")/.."
task_tmp=$(mktemp -d /tmp/larablogs-dusk-XXXXXX)
server_pid=''
driver_pid=''
cleanup() {
    [[ -z "$server_pid" ]] || kill "$server_pid" 2>/dev/null || true
    [[ -z "$driver_pid" ]] || kill "$driver_pid" 2>/dev/null || true
    rm -rf "$task_tmp"
}
trap cleanup EXIT
export APP_ENV=testing
export LARABLOGS_DUSK=1
export APP_URL="http://127.0.0.1:${LARABLOGS_DUSK_PORT:-18765}"
export APP_KEY="base64:$(openssl rand -base64 32)"
export DB_CONNECTION=sqlite DB_DATABASE="$task_tmp/database.sqlite"
export CACHE_STORE=database SESSION_DRIVER=database MAIL_MAILER=array
export DUSK_DRIVER_URL="http://127.0.0.1:${LARABLOGS_DUSK_DRIVER_PORT:-19515}"
touch "$DB_DATABASE"
npm run build
php artisan migrate --force --no-interaction >/dev/null
php tests/browser-fixtures.php
(cd public && exec php -S "127.0.0.1:${LARABLOGS_DUSK_PORT:-18765}" ../vendor/laravel/framework/src/Illuminate/Foundation/resources/server.php) >"$task_tmp/server.log" 2>&1 &
server_pid=$!
driver=vendor/laravel/dusk/bin/chromedriver-linux
if command -v chromedriver >/dev/null; then driver=$(command -v chromedriver); fi
"$driver" --port="${LARABLOGS_DUSK_DRIVER_PORT:-19515}" >"$task_tmp/driver.log" 2>&1 &
driver_pid=$!
for attempt in {1..40}; do
    if curl -fsS "$APP_URL/login" >/dev/null 2>&1 && curl -fsS "$DUSK_DRIVER_URL/status" >/dev/null 2>&1; then break; fi
    sleep .25
done
php artisan dusk "$@"
